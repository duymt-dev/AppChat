      }
    },
    {
      "id": "iv-approvals-pending",
      "category": "lookup",
      "seed": "live-seed",
      "actor": {
        "role": "owner"
      },
      "locale": "vi",
      "mode": "chat",
      "input": "Hội thoại này có yêu cầu nào của AI đang chờ duyệt không?",
      "context": {
        "route": "/inbox",
        "entity": "conversation",
