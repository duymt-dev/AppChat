      "actor": {
        "role": "owner"
      },
      "locale": "vi",
      "mode": "chat",
      "input": "Dịch tin mới nhất của khách sang tiếng Nhật",
      "context": {
        "route": "/inbox",
        "entity": "conversation",
        "id": "$seed.conversation.id",
        "surface": "drawer"
      },
      "expect": {
        "action": "ai.translate",
        "input": {
          "conversation_id": "$seed.conversation.id",
          "to": "ja"
        },
