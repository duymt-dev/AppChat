      "category": "support_categories",
      "seed": "live-seed",
      "actor": {
        "role": "owner"
      },
      "locale": "vi",
      "mode": "cowork",
      "input": "Sửa danh mục gợi ý của ticket: đưa \"$LAST\" lên đầu làm mặc định, bỏ \"$SECOND\", các nhãn còn lại giữ nguyên thứ tự và giữ đúng chữ.",
      "expect": {
        "confirm": true,
        "support_categories": true
      },
      "support_categories": {
        "kind": "edit"
      }
    },
    {
      "id": "sc-csv-import",
      "category": "support_categories",
      "seed": "live-seed",
      "actor": {
        "role": "owner"
      },
      "locale": "vi",
      "mode": "cowork",
