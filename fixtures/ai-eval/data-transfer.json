{
  "suite": "data-transfer",
  "cases": [
    { "id": "dt-im-contact", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "import", "entity": "contact", "file": "contacts" }, "input": "Nhập danh sách khách trong tệp này vào hệ thống. Dòng nào lỗi thì bỏ qua, nhập các dòng hợp lệ.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-im-product", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "import", "entity": "product", "file": "products" }, "input": "Nhập các sản phẩm trong tệp đính kèm vào danh mục sản phẩm.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-im-quote", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "import", "entity": "quote", "file": "quotes" }, "input": "Tạo báo giá nháp từ tệp này — mỗi mã báo giá là một báo giá gồm nhiều dòng hàng.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-im-order", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "import", "entity": "order", "file": "orders" }, "input": "Nhập đơn hàng nháp từ tệp đính kèm, mỗi mã đơn là một đơn.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-im-contract", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "import", "entity": "contract", "file": "contracts" }, "input": "Nhập các hợp đồng nháp trong tệp này. Bỏ dòng lỗi nếu có.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-im-invoice", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "import", "entity": "invoice", "file": "invoices" }, "input": "Tạo đề nghị thanh toán nháp từ tệp đính kèm theo mã đơn hàng.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-ex-contact", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "export", "entity": "contact" }, "input": "Xuất danh sách toàn bộ khách hàng ra tệp để tôi tải về.", "expect": { "confirm": false, "transfer": true } },
    { "id": "dt-ex-product", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "export", "entity": "product" }, "input": "Xuất toàn bộ sản phẩm loại dịch vụ ra Excel, không lọc thêm.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-ex-quote", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "export", "entity": "quote" }, "input": "Xuất toàn bộ báo giá ra Excel, không lọc thêm.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-ex-order", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "export", "entity": "order" }, "input": "Xuất toàn bộ đơn hàng ra Excel giúp tôi, không lọc thêm.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-ex-contract", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "export", "entity": "contract" }, "input": "Xuất toàn bộ hợp đồng ra tệp Excel, không lọc thêm.", "expect": { "confirm": true, "transfer": true } },
    { "id": "dt-ex-invoice", "category": "transfer", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "transfer": { "kind": "export", "entity": "invoice" }, "input": "Xuất toàn bộ đề nghị thanh toán ra Excel, không lọc thêm.", "expect": { "confirm": true, "transfer": true } }
  ]
}
