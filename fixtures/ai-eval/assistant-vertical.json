{
  "suite": "assistant-vertical",
  "cases": [
    { "id": "vert-quote-by-code", "category": "lookup", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "chat", "input": "Báo giá $QUOTE đang ở trạng thái nào, tổng bao nhiêu?", "expect": { "action": "quote.get", "input": { "quote_id": "$seed.quote.id" }, "confirm": false } },
    { "id": "vert-quotes-of-contact", "category": "lookup", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "chat", "input": "Khách $HOA_CODE có những báo giá nào?", "expect": { "action": "quote.search", "input": { "contact_id": "$seed.contacts.Nguyễn Thị Hoa.id" }, "confirm": false } },
    { "id": "vert-contact-by-code", "category": "lookup", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "chat", "input": "Cho tôi xem hồ sơ khách $HOA_CODE", "expect": { "action": "contact.get", "input": { "contact_id": "$seed.contacts.Nguyễn Thị Hoa.id" }, "confirm": false } },
    { "id": "vert-orders-of-contact", "category": "lookup", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "chat", "input": "Trần Văn Nam đã có đơn hàng nào chưa?", "expect": { "sequence": ["contact.search", "order.search"], "action": "order.search", "input": { "contact_id": "$seed.contacts.Trần Văn Nam.id" }, "confirm": false } },
    { "id": "vert-quote-nested-items", "category": "chain", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "input": "Lập báo giá cho Lê Minh Anh: 2 Gói chăm sóc da cơ bản và 1 lọ Serum dưỡng ẩm 30ml", "expect": { "sequence": ["product.search", "quote.create"], "action": "quote.create", "input": { "contact_id": "$seed.contacts.Lê Minh Anh.id", "items.0.qty": 2 }, "confirm": true } },
    { "id": "vert-quote-by-contact-code", "category": "create", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "input": "Tạo báo giá cho khách $HOA_CODE gồm 1 Gói chăm sóc da cơ bản", "expect": { "action": "quote.create", "input": { "contact_id": "$seed.contacts.Nguyễn Thị Hoa.id", "items.0.product_id": "$seed.products.Gói chăm sóc da cơ bản.id" }, "confirm": true } },
    { "id": "vert-phone-then-quote", "category": "chain", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "input": "Khách số 0901000004 muốn báo giá Liệu trình trị mụn 10 buổi", "expect": { "sequence": ["contact.search", "quote.create"], "action": "quote.create", "input": { "contact_id": "$seed.contacts.Phạm Thu Trang.id", "items.0.product_id": "$seed.products.Liệu trình trị mụn 10 buổi.id" }, "confirm": true } },
    { "id": "vert-extend-by-code", "category": "update", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "input": "Báo giá $QUOTE sắp hết hạn, gia hạn thêm 15 ngày", "expect": { "action": "quote.extend_validity", "input": { "quote_id": "$seed.quote.id", "days": 15 }, "confirm": true } },
    { "id": "vert-two-hoa-quote", "category": "clarify", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "input": "Lập báo giá Gói chăm sóc da cơ bản cho chị Hoa", "expect": { "ask_back": true, "confirm": false } },
    { "id": "vert-en-quote-lookup", "category": "lookup", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "en", "mode": "chat", "input": "What is the total of quote $QUOTE?", "expect": { "action": "quote.get", "input": { "quote_id": "$seed.quote.id" }, "confirm": false } }
  ]
}
