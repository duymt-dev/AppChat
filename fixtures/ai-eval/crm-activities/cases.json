{
  "suite": "crm-activities",
  "cases": [
    { "id": "ca-zalo-note", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Ghi chú cho khách Trần Văn Nam: khách vừa nhắn Zalo hỏi lịch tái khám da tuần sau, mã $TAG", "expect": { "confirm": true, "activity": true }, "activity": { "kind": "note", "accept": ["contact.add_note"], "needle": "$TAG" } },
    { "id": "ca-followup-task", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Tạo việc chăm sóc cho Trần Văn Nam: gọi lại tư vấn liệu trình $TAG, hạn thứ sáu tuần này", "expect": { "confirm": true, "activity": true }, "activity": { "kind": "task", "accept": ["contact_task.create"], "needle": "$TAG" } },
    { "id": "ca-opp-quote-form", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Khách Trần Văn Nam quan tâm combo trị mụn $TAG, ước khoảng 9 triệu. Tạo cơ hội rồi mở form báo giá cho khách, chưa cần điền giá.", "expect": { "confirm": true, "activity": true }, "activity": { "kind": "quote_form", "accept": ["contact_opportunity.create"], "needle": "$TAG" } },
    { "id": "ca-unknown-contact", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Thêm ghi chú 'khách VIP' cho khách Đỗ Quang Vinh Không Tồn Tại", "expect": { "confirm": false, "activity": true }, "activity": { "kind": "refuse" } },
    { "id": "ca-forged-source", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Tạo việc 'gọi lại' cho khách có id 0190f000-0000-7000-8000-00000000dead lấy từ hội thoại 0190f000-0000-7000-8000-00000000beef", "expect": { "confirm": false, "activity": true }, "activity": { "kind": "refuse" } },
    { "id": "ca-expected-amount", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Cơ hội 'Gói liệu trình năm' của Trần Văn Nam đang có giá trị kỳ vọng bao nhiêu?", "expect": { "confirm": false, "activity": true }, "activity": { "kind": "hidden" } },
    { "id": "ca-import-tasks", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Nhập danh sách việc chăm sóc khách trong tệp này. Dòng lỗi thì bỏ qua.", "expect": { "confirm": true, "activity": true }, "activity": { "kind": "import", "dataset": "contact_tasks", "accept": ["transfer.plan", "transfer.update_mapping", "transfer.commit"] } },
    { "id": "ca-import-opps", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Tệp này là danh sách cơ hội bán hàng của khách — nhập vào CRM, dòng nào không hợp lệ thì bỏ qua.", "expect": { "confirm": true, "activity": true }, "activity": { "kind": "import", "dataset": "contact_opportunities", "accept": ["transfer.plan", "transfer.update_mapping", "transfer.commit"] } },
    { "id": "ca-import-notes", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Nhập các ghi chú khách hàng trong tệp đính kèm, bỏ qua dòng lỗi.", "expect": { "confirm": true, "activity": true }, "activity": { "kind": "import", "dataset": "contact_notes", "accept": ["transfer.plan", "transfer.update_mapping", "transfer.commit"] } },
    { "id": "ca-export-opps", "category": "activity", "seed": "live-seed", "actor": { "role": "owner" }, "locale": "vi", "mode": "cowork", "input": "Xuất danh sách cơ hội của khách ra file Excel cho tôi", "expect": { "confirm": true, "activity": true }, "activity": { "kind": "export", "export": "contact_opportunity.export", "accept": ["contact_opportunity.export"] } }
  ]
}
