# Schema env backend — validate zod lúc boot (packages/core/src/kernel/env.ts). Không commit .env thật.
# TIP sau thêm biến của mình vào đây và vào baseEnv (DB: TIP-002, Redis / khoá mã hoá: TIP-003, mail: TIP-004, LLM: TIP-019…).

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# apps/api
API_PORT=4000

# apps/worker: channels | ai | jobs | all (dev gộp một tiến trình)
ROLE=all

# apps/web: mock (D38) | http
NEXT_PUBLIC_API_MODE=mock

# packages/db (TIP-002) — `pnpm --filter @appchat/db db:setup` sinh các dòng dưới vào .env (máy dev; DC-009)
PLATFORM_DATABASE_URL=postgresql://appchat_platform_app:<pw>@localhost:5432/appchat_platform
TENANT_DATABASE_URL=postgresql://appchat_tenant_app:<pw>@localhost:5432/postgres
PROVISIONER_DATABASE_URL=postgresql://appchat_provisioner:<pw>@localhost:5432/postgres
MIGRATOR_DATABASE_URL=postgresql://appchat_migrator:<pw>@localhost:5432/appchat_platform
TENANT_TEMPLATE_DB=appchat_tenant_template
TENANT_POOL_MAX=3
TENANT_CLIENT_CACHE=100
TENANT_CLIENT_IDLE_MS=600000

# kernel (TIP-003) — Redis (Memurai ở dev) cho confirm_token, outbox:dirty, BullMQ; khoá chủ 32 byte (base64)
REDIS_URL=redis://127.0.0.1:6379/0
APP_ENC_KEY=<32 byte base64>

# identity (TIP-004) — JWT HS256 (≥ 32 byte); xoay khoá: JWT_KID mới + JWT_SECRETS_OLD="k1:<khoá cũ>"
JWT_SECRET=<≥ 32 byte ngẫu nhiên>
JWT_KID=k1
# console (dev / test — cấm ở production) | brevo (D34) | smtp (dự phòng — TIP-006)
MAIL_PROVIDER=console
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=no-reply@appchat.vn
MAIL_FROM_NAME=AppChat
# dev / e2e:http (TIP-011): thư console ghi ra <dir>/<email>.txt — cấm ở production
MAIL_CONSOLE_DIR=
# mock | vietqr (OQ-05)
TAX_LOOKUP_PROVIDER=mock
APP_PUBLIC_URL=http://localhost:3000
# dev http không có TLS → false; production luôn true
COOKIE_SECURE=false

# apps/web chế độ http (TIP-011): Next rewrite /api/* → API
API_URL=http://localhost:4000

# Thu phí nền tảng (TIP-010): tài khoản nhận tiền AppChat + nguồn đối soát (mock | sepay). Production cấm mock.
PLATFORM_BANK_BIN=970436
PLATFORM_BANK_NAME=Vietcombank
PLATFORM_BANK_ACCOUNT_NO=0071000888999
PLATFORM_BANK_ACCOUNT_NAME=CTY CP APPCHAT
PLATFORM_BANK_FEED=mock
SEPAY_WEBHOOK_KEY=
MOCK_BANK_FEED_KEY=mock-bank-feed-dev
