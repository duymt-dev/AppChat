# Schema env backend — validate zod lúc boot (packages/core/src/kernel/env.ts). Không commit .env thật.
# TIP sau thêm biến của mình vào đây và vào baseEnv (DB: TIP-002, Redis / khoá mã hoá: TIP-003, mail: TIP-004, LLM: TIP-019…).

NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# apps/api
API_PORT=4000

# apps/worker: channels | ai | jobs | all (dev gộp một tiến trình)
ROLE=all

# apps/web: mock (D38) | http
NEXT_PUBLIC_API_MODE=mock
