// tenant/documents.prisma — sở hữu: TIP-028 (02-TASK-GRAPH.md → Bản đồ sở hữu file).
// Bảng: doc_template (D30 — standards/documents/templates.md). Không Prisma relation xuyên domain (Blueprint §2.1).
// Mỗi loại tối đa một mẫu mặc định đang dùng (unique partial viết SQL ở migration 028).

enum DocTemplateKind {
  quote
  contract
  payment_request
  receipt

  @@map("doc_template_kind")
}

enum DocTemplateSource {
  rich
  docx

  @@map("doc_template_source")
}

model DocTemplate {
  id              String            @id @db.Uuid
  kind            DocTemplateKind
  /// Loại hợp đồng (dịch vụ / mua bán / thuê…) — chỉ với kind=contract (TIP-030 lọc theo loại).
  contractKind    String?           @map("contract_kind")
  name            String
  source          DocTemplateSource
  /// Thân HTML + biến `{{…}}` của mẫu `rich`.
  bodyHtml        String?           @map("body_html")
  /// Tệp Word gốc (bảng `file`, purpose document) của mẫu `docx`.
  docxFileId      String?           @map("docx_file_id") @db.Uuid
  /// Vị trí → biến người dùng đã xác nhận `[{ placeholder, variable }]`.
  fieldMap        Json              @default("[]") @map("field_map")
  /// Mục bảng kiểm pháp lý `[{ key, ok }]` lúc lưu (cảnh báo, không chặn).
  checklistResult Json              @default("[]") @map("checklist_result")
  isDefault       Boolean           @default(false) @map("is_default")
  version         Int               @default(1)
  updatedBy       String?           @map("updated_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)

  @@map("doc_template")
}

/// TIP-028b §1: trạng thái render PDF chứng từ phát hành (queue `doc-render`, ROLE=jobs). Một dòng mỗi chứng từ; thử lại → `generation` + 1.
enum DocRenderStatus {
  pending_render
  rendered
  render_failed

  @@map("doc_render_status")
}

model DocumentRender {
  id         String          @id @db.Uuid
  /// Loại chứng từ đăng ký render (`quote`…) — domain chủ đăng ký cách render + phát hành.
  kind       String
  documentId String          @map("document_id") @db.Uuid
  generation Int             @default(1)
  status     DocRenderStatus @default(pending_render)
  attempts   Int             @default(0)
  /// Mã lỗi đã làm sạch của lần cuối (không stack / PII).
  error      String?
  fileId     String?         @map("file_id") @db.Uuid
  /// Tham số phát hành chụp lúc yêu cầu (kênh, định dạng, người gửi `{type, id}`) — không nội dung chứng từ.
  request    Json            @default("{}")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([kind, documentId])
  @@map("document_render")
}
