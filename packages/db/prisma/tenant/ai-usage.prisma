// tenant/ai-usage.prisma — sở hữu: TIP-019b (02-TASK-GRAPH.md → Bản đồ sở hữu file).
// Quyết định: DC-251, DC-379.
// Bảng: ai_root_budget (ngân sách chung của cây run — một lời gọi thật / gốc tại một thời điểm), ai_usage_group (nhóm tính tiền logic,
// làm tròn lên một lần theo tổng chi phí thô luỹ kế), ai_usage_receipt (biên nhận từng lần gọi thật — ghi trước khi gửi),
// ai_usage_settlement (lượt quyết toán ví: (nhóm, thứ tự) duy nhất, số trừ bất biến), ai_expiry_delivery (thông báo hết hạn duyệt một
// lần cho Owner hiện tại). FK / CHECK / partial index viết tay ở migration.

/// Ngân sách gốc (một dòng / cây run). `observed` = credit đã định giá (kể cả phần ví không đủ để trừ) — hết thì không mở lời gọi mới.
model AiRootBudget {
  rootRunId       String    @id @map("root_run_id") @db.Uuid
  maxCredits      Int       @map("max_credits")
  charged         Int       @default(0)
  observed        Int       @default(0)
  unbilled        Int       @default(0)
  activeAttemptId String?   @map("active_attempt_id") @db.Uuid
  activeSince     DateTime? @map("active_since") @db.Timestamptz(6)
  quarantined     Boolean   @default(false)
  cancelGen       Int       @default(0) @map("cancel_gen")
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("ai_root_budget")
}

/// Nhóm tính tiền: `id` = `<run>:<kind>:<logical_step>`. `raw_cost` cộng đúng (numeric); `charged` = đã trừ ví (watermark).
model AiUsageGroup {
  id          String   @id
  runId       String   @map("run_id") @db.Uuid
  rootRunId   String   @map("root_run_id") @db.Uuid
  kind        String
  logicalStep Int      @map("logical_step")
  rawCost     Decimal  @default(0) @map("raw_cost") @db.Decimal(20, 8)
  charged     Int      @default(0)
  nextOrdinal Int      @default(0) @map("next_ordinal")
  denied      Boolean  @default(false)
  /// Dòng `ai_run_step(llm)` của nhóm (tạo ở lượt quyết toán đầu).
  stepId      String?  @map("step_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([runId, kind, logicalStep], map: "ai_usage_group_run_step_key")
  @@map("ai_usage_group")
}

/// Một lần gọi thật (ứng viên `candidate`, lô `batch`). Giá chụp lúc gửi — đổi giá sau đó không đổi số đã tính.
model AiUsageReceipt {
  id          String   @id @db.Uuid
  groupId     String   @map("group_id")
  runId       String   @map("run_id") @db.Uuid
  rootRunId   String   @map("root_run_id") @db.Uuid
  logicalStep Int      @map("logical_step")
  candidate   Int
  batch       Int      @default(0)
  status      String   @default("dispatched")
  provider    String
  model       String
  priceIn     Decimal  @map("price_in") @db.Decimal(12, 4)
  priceOut    Decimal  @map("price_out") @db.Decimal(12, 4)
  tokensIn    Int      @default(0) @map("tokens_in")
  tokensOut   Int      @default(0) @map("tokens_out")
  rawCost     Decimal? @map("raw_cost") @db.Decimal(20, 8)
  latencyMs   Int      @default(0) @map("latency_ms")
  source      String   @default("ai")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([groupId, candidate, batch], map: "ai_usage_receipt_attempt_key")
  @@map("ai_usage_receipt")
}

/// Lượt quyết toán: `intent` (đã định số, chưa chắc ví đã trừ) → `settled` (ví + tenant xong) | `denied` (ví không đủ — không nợ).
model AiUsageSettlement {
  groupId   String    @map("group_id")
  ordinal   Int
  receiptId String    @map("receipt_id") @db.Uuid
  delta     Int
  ledgerRef String    @unique(map: "ai_usage_settlement_ledger_ref_key") @map("ledger_ref")
  status    String    @default("intent")
  applied   Int?
  ledgerId  String?   @map("ledger_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)

  @@id([groupId, ordinal])
  @@map("ai_usage_settlement")
}

/// Biên nhận thông báo hết hạn duyệt (TIP-019b §4.5): một dòng / yêu cầu duyệt; người nhận chọn lúc gửi (Owner hiện tại), chỉ đổi khi chưa gửi.
model AiExpiryDelivery {
  approvalId      String    @id @map("approval_id") @db.Uuid
  eventId         String    @map("event_id")
  recipientUserId String?   @map("recipient_user_id") @db.Uuid
  phase           String    @default("pending")
  notificationId  String?   @map("notification_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6)

  @@map("ai_expiry_delivery")
}

