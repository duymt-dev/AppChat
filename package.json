{
  "name": "appchat",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@appchat/web",
    "build": "turbo run build",
    "lint": "turbo run lint && node tools/scripts/lint-size.mjs && node tools/scripts/lint-tokens.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:size": "node tools/scripts/lint-size.mjs",
    "lint:tokens": "node tools/scripts/lint-tokens.mjs",
    "i18n:check": "node tools/scripts/i18n-check.mjs",
    "parity": "pnpm --filter @appchat/parity run parity",
    "parity:baseline": "pnpm --filter @appchat/parity run baseline",
    "e2e": "pnpm --filter @appchat/web run e2e"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
